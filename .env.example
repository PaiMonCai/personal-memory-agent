# 前端构建期变量（可选）。默认走同源 /api（由 Nginx 反代到 Hono），
# 只有把前端部署到与 API 不同的域名 / 端口时才需要设置，
# 例如 VITE_API_BASE=https://api.example.com/api
# VITE_API_BASE=/api

NODE_ENV=production
PORT=3000
APP_ORIGIN=https://memory.example.com

# PostgreSQL：只让 API 容器访问，不要把 5432 暴露到公网。
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://pma:replace-with-a-strong-database-password@postgres:5432/pma

# 会话
SESSION_DAYS=30

# 邮箱验证码
OTP_PEPPER=replace-with-a-long-random-secret
OTP_TTL_MINUTES=10
OTP_MAX_PER_HOUR=5
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=replace-me
MAIL_FROM="信息管家 <mailer@example.com>"

# 默认 AI：OpenAI 兼容接口，可直接指向你自己的 NewAPI/网关。
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-me
AI_MODELS=gpt-5.6
AI_DAILY_LIMIT=200

# 用 32 字节随机值的 base64 或 64 位 hex。
# 用于加密 preferences.ai 中用户自定义供应商的 API Key。
PREFERENCES_ENCRYPTION_KEY=replace-with-32-byte-key
